---
import Shell from './Shell.astro';
import PersonalNote from './PersonalNote.astro';
import Honors from './Honors.astro';
import ProjectCard from './ProjectCard.astro';
import Icon from './ProfileIcon.astro';
import {copy,projects,collaborations,type Lang} from '../data/portfolio';
const {lang='en'}=Astro.props as {lang:Lang}; const t=copy[lang]; const base=lang==='en'?'/':'/zh/';
---
<Shell lang={lang} home={base} alternate={lang==='en'?'/zh/':'/'}>
<div class="page">
<section class="intro-section" id="about">
<aside class="profile"><button class="portrait-toggle" type="button" aria-label={lang==='en'?'Switch portrait':'切换头像'} aria-pressed="false"><img class="portrait" src="/images/portrait.jpg" alt={lang==='zh'?'杨铠铭':'Kaiming Yang'} width="160" height="160"/></button><div class="profile-details"><a class="profile-email" href="mailto:ykaiming@u.nus.edu"><Icon name="mail"/>ykaiming@u.nus.edu</a><span class="location"><Icon name="location"/>Singapore</span><div class="profile-links"><a href="https://github.com/Kaiming-Y" target="_blank" rel="noreferrer"><Icon name="github"/>GitHub <span>↗</span></a><a href="https://www.linkedin.com/in/kaimingyang1024/" target="_blank" rel="noreferrer"><Icon name="linkedin"/>LinkedIn <span>↗</span></a><a href="https://scholar.google.com/citations?user=BO7L8uoAAAAJ" target="_blank" rel="noreferrer"><Icon name="scholar"/>Google Scholar <span>↗</span></a></div></div></aside>
<div class="intro-content"><h1>Kaiming Yang <span>杨铠铭</span></h1><div class="current-role">M.Sc. student @ NUS <span>·</span> Research Intern @ Huawei Singapore</div><p class="bio" set:html={t.intro}/><p class="research-summary" set:html={t.summary}/><section class="research-interests" aria-labelledby="research-interests-title"><h2 id="research-interests-title">{lang==='en'?'Research Interests':'研究兴趣'}</h2><div class="topics interest-tags"><span><Icon name="agent"/>{lang==='en'?'Digital Agents':'数字智能体'}</span><span><Icon name="agent"/>{lang==='en'?'Proactive Agents':'主动式智能体'}</span><span><Icon name="world"/>{lang==='en'?'Agentic World Modeling':'智能体世界建模'}</span><span><Icon name="space"/>{lang==='en'?'Spatial Intelligence':'空间智能'}</span></div></section><ul class="research-focus">{t.focus.map(([label,body],i)=><li><span class="focus-index">0{i+1}</span><div><strong>{label}</strong><p>{body}</p></div></li>)}</ul><blockquote class="personal-motto">“Stay hungry, Stay foolish”</blockquote><div class="intro-actions"><a class="pill solid" href="mailto:ykaiming@u.nus.edu"><span>↗</span> {t.contact}</a></div></div>
</section>
<div class="content-sections">
<section id="education" class="section"><div class="section-title"><h2>{t.education}</h2><span>01</span></div><div class="education-list"><article class="education-row"><a class="school-icon" href="https://www.nus.edu.sg/" target="_blank" rel="noopener noreferrer" aria-label={lang==='en'?'National University of Singapore official website':'新加坡国立大学官网'}><img src="/logos/nus.jpg" alt="National University of Singapore logo"/></a><div><h3><a class="school-link" href="https://www.nus.edu.sg/" target="_blank" rel="noopener noreferrer">{t.nus} <span aria-hidden="true">↗</span></a></h3><p>{t.nusDegree}</p></div><time>2025.08 — {t.present}</time></article><article class="education-row"><a class="school-icon xdu" href="https://www.xidian.edu.cn/" target="_blank" rel="noopener noreferrer" aria-label={lang==='en'?'Xidian University official website':'西安电子科技大学官网'}><img src="/logos/xidian.jpg" alt="Xidian University emblem"/></a><div><h3><a class="school-link" href="https://www.xidian.edu.cn/" target="_blank" rel="noopener noreferrer">{t.xdu} <span aria-hidden="true">↗</span></a></h3><p>{t.xduDegree}</p></div><time>2021.09 — 2025.06</time></article></div></section>
<section id="experience" class="section"><div class="section-title"><h2>{t.experience}</h2><span>02</span></div><div class="experience-list"><article class="experience-row"><div class="company-logo"><img src="/logos/huawei.png" width="133" height="30" alt="Huawei"/></div><div><div class="experience-heading"><h3>{t.huaweiOrg}</h3><time>2026.06 — {t.present}</time></div><p class="job-department">{t.huaweiDept}</p><p class="job-role">Research Intern</p><p class="job-description">{t.huaweiText}</p><div class="topics"><span><Icon name="camera"/>Camera Control</span><span><Icon name="space"/>Geometry-aware World Models</span><span><Icon name="agent"/>Agentic World Models</span></div></div></article><article class="experience-row"><div class="company-logo"><img src="/logos/yonyou.png" width="61" height="40" alt="Yonyou 用友"/></div><div><div class="experience-heading"><h3>{t.yonyouOrg}</h3><time>2023.07 — 2023.08</time></div><p class="job-department">{t.yonyouDept}</p><p class="job-role">{t.yonyouRole}</p><p class="job-description">{t.yonyouText}</p><div class="topics"><span><Icon name="code"/>Software Engineering</span><span><Icon name="chart"/>Data Visualization</span><span><Icon name="dashboard"/>BI Dashboards</span></div></div></article></div></section>
<section id="work" class="section"><div class="section-title"><h2>{t.work}</h2><span>03</span></div><div class="projects">{projects.map(p=><ProjectCard project={p} lang={lang}/>)}</div></section>
<section id="collaborations" class="section"><div class="section-title"><h2>{t.other}</h2><span>04</span></div>{t.otherEn&&<p class="section-intro">{t.otherEn}</p>}<div class="projects">{collaborations.map(p=><ProjectCard project={p} lang={lang}/>)}</div></section>
<Honors lang={lang}/>
<PersonalNote lang={lang}/>
</div></div>
</Shell>
